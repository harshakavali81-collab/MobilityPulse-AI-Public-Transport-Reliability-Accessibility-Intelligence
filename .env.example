# Demo CORS (set exact production HTTPS domain when deployed)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
GTFS_ZIP_PATH=
OBSERVATIONS_CSV_PATH=

# Optional protected API access. For a backend called directly from the
# browser do NOT put this secret in VITE_* variables or bundled JavaScript.
MOBILITYPULSE_API_KEY=
# Optional in-memory throttling, disabled for local demo unless configured.
# Not a substitute for distributed rate limiting at an edge gateway.
MOBILITYPULSE_RATE_LIMIT_PER_MINUTE=0
MOBILITYPULSE_MAX_POST_BYTES=8192

# Optional agency-authorized GTFS-Realtime diagnostics.
# Explicitly execute scripts/refresh_realtime.py on an approved host only.
GTFS_RT_URL=
GTFS_RT_ALLOWED_HOSTS=
GTFS_RT_STATE_PATH=data/interim/feed_state.json
